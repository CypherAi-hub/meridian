# No wallet key is needed for paper mode. Never commit credentials.
PHANTOM_MODE=PAPER
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
PHANTOM_SOURCE=rpc
# Default public endpoint: 1000ms. Set according to your authenticated provider's limits.
PHANTOM_RPC_INTERVAL_MS=1000
PHANTOM_WALLET_HISTORY=true
# For Yellowstone set PHANTOM_SOURCE=yellowstone and provide your provider URL/token.
YELLOWSTONE_ENDPOINT=
YELLOWSTONE_TOKEN=
# PostgreSQL is required for a deployed canonical warehouse; unset uses local PGLite.
PHANTOM_DATABASE_URL=
PHANTOM_DATA_DIR=./data/warehouse
JUPITER_API_KEY=
# Public source provenance for deployments without a Git checkout (40-character commit).
PHANTOM_SOURCE_COMMIT=
# Quote-only forward experiment, with a separate frozen manifest; never a trade policy.
PHANTOM_FORWARD_RESEARCH=true
PHANTOM_ENGINE_PORT=8790
PHANTOM_INITIAL_SOL=1
PHANTOM_TRADE_SOL=0.01
PHANTOM_MAX_TRADE_SOL=0.02
PHANTOM_MIN_RESERVE_SOL=0.1
PHANTOM_KILL_SWITCH=false
PHANTOM_MIN_DELAY_MS=2000
PHANTOM_MAX_QUOTE_AGE_MS=5000
# Live support never activates from PHANTOM_MODE alone.
PHANTOM_ENABLE_LIVE=false
PHANTOM_DEDICATED_WALLET=
PHANTOM_WALLET_KEYFILE=
